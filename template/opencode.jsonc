{
  "$schema": "https://opencode.ai/config.json",
  // 工作流守卫按 bash 语法检查命令；Windows 上 "bash" 解析为 Git Bash。不要改成 PowerShell 或 cmd，否则 shell 命令会被拒绝。
  "shell": "bash",
  "worktree": { "directory": ".worktrees" },
  // 模型：根 "model" 是默认值；"agents" 可为单个代理指定，格式 provider/model 或 provider/model#variant。
  // 子代理未指定时继承发起它的会话模型。通过 /workflow-setup 明确选择继承或固定；没有选择记录时 reviewer 未指定会提示。
  // "agents": { "reviewer": { "model": "<YOUR_PROVIDER>/<YOUR_MODEL>" } },
  "permissions": [
    { "action": "workflow_setup", "resource": "*", "effect": "ask" },
    // 在 shell 中用接入 CLI 应用计划与 workflow_setup 一样需要确认；protection 生成的权限块须保持在末尾。
    { "action": "shell", "resource": "*onboarding.mjs*apply*", "effect": "ask" },
    { "action": "workflow_release", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "vendor/*", "effect": "deny" },
    { "action": "edit", "resource": "*/vendor/*", "effect": "deny" },
    { "action": "edit", "resource": "generated/*", "effect": "deny" },
    { "action": "edit", "resource": "*/generated/*", "effect": "deny" }
  ]
}
