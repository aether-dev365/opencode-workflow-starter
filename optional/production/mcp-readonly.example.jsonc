{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "operations-prod": {
        "type": "remote",
        "url": "{env:READONLY_MCP_URL}",
        "disabled": true,
        "oauth": false,
        "headers": { "Authorization": "Bearer {env:READONLY_MCP_TOKEN}" }
      }
    }
  },
  "permissions": [{ "action": "operations-prod_*", "resource": "*", "effect": "ask" }]
}
