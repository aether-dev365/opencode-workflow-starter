{
  "rules": [
    { "id": "private-keys", "actions": ["read", "edit"], "paths": ["*.pem", "*.key", "*.p12", "*.pfx"], "effect": "deny", "reason": "私钥与证书包不可读取或编辑；公开证书请用精确 allow 放行。" },
    { "id": "ssh-keys", "actions": ["read", "edit"], "paths": ["*id_rsa", "*id_ecdsa", "*id_ed25519", "*id_dsa"], "effect": "deny", "reason": "SSH 私钥不可读取或编辑；同名 .pub 公钥不受影响。" },
    { "id": "credential-files", "actions": ["read", "edit"], "paths": ["*.netrc", "*.pypirc", "*.aws/credentials"], "effect": "deny", "reason": "凭据文件不可读取或编辑；使用示例配置或环境变量。" },
    { "id": "terraform-state", "actions": ["read", "edit"], "paths": ["*.tfstate", "*.tfstate.*"], "effect": "deny", "reason": "Terraform 状态文件含明文资源属性与凭据；通过远端后端查看。" }
  ]
}
